// دالة لرفع البيانات السحابية لأول مرة
function uploadInitialCoursesToFirebase() {
    const coursesRef = database.ref('courses');
    coursesRef.once('value', (snapshot) => {
        if (!snapshot.exists()) {
            const dataToUpload = {};
            spaceXCourses.forEach(course => {
                dataToUpload[course.id] = { name: course.name, downloadUrl: course.downloadUrl };
            });
            coursesRef.set(dataToUpload)
                .then(() => console.log("✅ تم رفع الكورسات بنجاح إلى Firebase!"))
                .catch((err) => console.error("❌ فشل الرفع:", err));
        } else {
            console.log("ℹ️ الكورسات مرفوعة مسبقاً في السحابة.");
        }
    });
}
uploadInitialCoursesToFirebase();
